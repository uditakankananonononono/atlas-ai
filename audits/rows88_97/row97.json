    {
      "id": "wire_hash",
      "path": "backend/app/apply/pitch_execution.py",
      "old": "'wire_sha256':hashlib.sha256(raw).hexdigest()",
      "new": "'wire_sha256':'0'*64"
    },
    {
      "id": "subject",
      "path": "backend/app/apply/pitch_execution.py",
      "old": "message['Subject']=payload['subject']",
      "new": "message['Subject']='wrong subject'"
    },
    {
      "id": "preview_scope",
      "path": "backend/app/apply/pitch_execution.py",
      "old": "'status':'preview_only_not_authority'",
      "new": "'status':'approved'"
    },
    {
      "id": "attachment_refusal",
      "path": "backend/app/apply/pitch_execution.py",
      "old": "or payload['attachment_hashes']:\n        raise ValueError('attachment-free pitch outreach required')",
      "new": ":\n        raise ValueError('attachment-free pitch outreach required')"
    }
  ]
}
