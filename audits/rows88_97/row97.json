{
  "row": 97,
  "selectors": [
    "tests/apply/test_pitch_execution.py"
  ],
  "timeout_seconds": 45,
  "limits": [
    "preview is not send authority or provider delivery",
    "live send and reconciliation untested",
    "no manuscript attachments",
    "whole repository untested"
  ],
  "mutations": [
    {
      "id": "descriptor_id",
      "path": "backend/app/apply/pitch_execution.py",
      "old": "digest=hashlib.sha256(json.dumps(effect,sort_keys=True,separators=(',',':')).encode()).hexdigest()",
      "new": "digest='0'*64"
