ATLAS_ENV=development
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@postgres:5432/atlas
ATLAS_REDIS_URL=redis://redis:6379/0
ATLAS_API_KEY_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
# Users add their own provider keys through the encrypted credential service.

# Phase 1 social read-API credentials; move to the per-user encrypted vault before multi-tenant deploy.
ATLAS_META_ACCESS_TOKEN=
ATLAS_X_BEARER_TOKEN=
ATLAS_LINKEDIN_ACCESS_TOKEN=
ATLAS_LINKEDIN_ORG_ID=

# Embeddings: default OpenAI BYOK; set ollama for local BGE.
ATLAS_EMBEDDING_PROVIDER=openai
ATLAS_OPENAI_EMBEDDING_MODEL=text-embedding-3-large
ATLAS_OLLAMA_URL=http://ollama:11434
ATLAS_OLLAMA_EMBEDDING_MODEL=bge-m3

GEMINI_API_KEY=
ATLAS_GEMINI_MODEL=gemini-2.5-flash
ATLAS_ELIGIBILITY_MODEL=MoritzLaurer/deberta-v3-large-zeroshot-v2.0
