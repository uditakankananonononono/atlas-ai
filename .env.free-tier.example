# Render backend (secrets are entered in Render, never committed)
ATLAS_ENV=production
ATLAS_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
ATLAS_REDIS_URL=rediss://default:PASSWORD@UPSTASH_HOST:6379
ATLAS_SECRET_PROVIDER=platform-environment
ATLAS_TRUST_PLATFORM_SECRETS=1
ATLAS_OIDC_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
ATLAS_OIDC_AUDIENCE=authenticated
ATLAS_OIDC_TENANT_CLAIM=sub
ATLAS_RATE_LIMIT_PER_MINUTE=60
ATLAS_REQUEST_TIMEOUT_SECONDS=25
ATLAS_FREE_TIER=1
ATLAS_LOCAL_OLLAMA_ENABLED=0

# Vercel frontend
ATLAS_INTERNAL_API_URL=https://atlas-api.onrender.com
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_IN_VERCEL
