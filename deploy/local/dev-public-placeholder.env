# ATLAS-U-1209: ALL values are PUBLIC-DEMO parse-only, not secrets or real credentials.
# dev-only-public, no confidentiality/security claim. CLI --env-file REQUIRED.
# Exactly ONE PUBLIC-DEMO-ONLY valid-format Fernet key definition, here only.
# Bootstrap replaces both Atlas key names with peer-provisioned Vault values.
# Dev issuer requires a peer-provided reachable OIDC server; auth NEVER relaxed.
POSTGRES_PASSWORD=PUBLIC-DEMO-ONLY-postgres
REDIS_PASSWORD=PUBLIC-DEMO-ONLY-redis
ATLAS_OIDC_ISSUER=http://localhost:18080/realms/atlas-dev
ATLAS_OIDC_AUDIENCE=atlas-dev
ATLAS_TOKEN_KEY=PUBLIC-DEMO-ONLY-parse-token
ATLAS_API_KEY_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
