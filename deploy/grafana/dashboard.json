{
  "title": "Atlas Operations",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "API request rate",
      "targets": [
        {
          "expr": "rate(http_server_request_duration_seconds_count[5m])",
          "refId": "A",
          "legendFormat": "{{method}} {{route}} {{status}}"
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Celery queue depth",
      "targets": [
        {
          "expr": "atlas_celery_queue_depth",
          "refId": "A",
          "legendFormat": "{{queue}}"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Provider latency",
      "targets": [
        {
          "expr": "rate(atlas_provider_latency_seconds_sum[5m])/rate(atlas_provider_latency_seconds_count[5m])",
          "refId": "A",
          "legendFormat": "{{provider}} {{outcome}}"
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "API latency p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_server_request_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{route}}"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "API server error rate",
      "targets": [
        {
          "expr": "(sum(rate(http_server_request_duration_seconds_count{status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_server_request_duration_seconds_count[5m])), 0.001)",
          "refId": "A",
          "legendFormat": "server errors"
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Provider reported token rate",
      "targets": [
        {
          "expr": "sum by (provider, kind) (rate(atlas_provider_tokens_total[5m]))",
          "refId": "A",
          "legendFormat": "{{provider}} {{kind}}"
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Process CPU rate",
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[5m])",
          "refId": "A",
          "legendFormat": "API CPU"
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Process resident memory",
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "refId": "A",
          "legendFormat": "API RSS"
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Broker metrics available",
      "targets": [
        {
          "expr": "atlas_celery_queue_scrape_success",
          "refId": "A",
          "legendFormat": "broker available"
        }
      ],
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ],
  "uid": "atlas-operations",
  "version": 1
}
